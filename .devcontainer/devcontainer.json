{
  "name": "MediLogix (api + front-pharma + db + pgAdmin)",
  "dockerComposeFile": "compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Angular.ng-template",
        "Prisma.prisma",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "forwardPorts": [3000, 4200, 5433, 5050],
  "portsAttributes": {
    "3000": { "label": "API (NestJS)", "onAutoForward": "notify" },
    "4200": { "label": "Front-pharma (Angular)", "onAutoForward": "openBrowser" },
    "5433": { "label": "PostgreSQL (host port, container listens on 5432)", "onAutoForward": "silent" },
    "5050": { "label": "pgAdmin", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
